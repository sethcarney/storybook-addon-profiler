{
  "name": "storybook-addon-profiler",
  "description": "A performance profiler panel addon for Storybook — real-time FPS, INP, CLS, memory and more. Works with all Storybook frameworks.",
  "type": "module",
  "version": "1.1.1",
  "license": "Apache-2.0",
  "keywords": [
    "storybook",
    "addon",
    "performance",
    "profiler",
    "web-vitals",
    "fps",
    "inp",
    "cls"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sethcarney/storybook-addon-profiler.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./preset": {
      "types": "./dist/preset.d.ts",
      "default": "./dist/preset.js"
    },
    "./decorator": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "**/*.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev": "tsup && concurrently \"tsup --watch --no-clean\" \"bun run storybook:react\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src/ --cache",
    "test": "vitest run",
    "test:watch": "vitest",
    "tsc": "tsc --noEmit",
    "storybook:react": "storybook dev -p 6006 --config-dir tests/react/.storybook",
    "storybook:vue": "storybook dev -p 6007 --config-dir tests/vue/.storybook",
    "storybook:angular": "storybook dev -p 6008 --config-dir tests/angular/.storybook",
    "build-storybook:react": "storybook build --config-dir tests/react/.storybook --output-dir storybook-static/react",
    "build-storybook:vue": "storybook build --config-dir tests/vue/.storybook --output-dir storybook-static/vue",
    "build-storybook:angular": "storybook build --config-dir tests/angular/.storybook --output-dir storybook-static/angular"
  },
  "bundler": {
    "managerEntries": [
      "src/manager.tsx"
    ],
    "previewEntries": [
      "src/preview.ts"
    ],
    "nodeEntries": [
      "src/preset.ts"
    ]
  },
  "devDependencies": {
    "@angular/animations": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.0",
    "@storybook/angular": "^10.2.10",
    "@storybook/icons": "^2.0.1",
    "@storybook/react": "^10.2.10",
    "@storybook/react-vite": "^10.2.10",
    "@storybook/vue3-vite": "^10.2.10",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.14",
    "ag-grid-angular": "^36.0.0",
    "ag-grid-community": "^36.0.0",
    "ag-grid-react": "^36.0.0",
    "ag-grid-vue3": "^36.0.0",
    "concurrently": "^10.0.3",
    "prettier": "^3.8.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "storybook": "^10.2.10",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "vue": "^3.5.28",
    "zone.js": "^0.16.1"
  },
  "peerDependencies": {
    "@storybook/icons": "*",
    "storybook": "*"
  },
  "storybook": {
    "displayName": "Performance Profiler",
    "supportedFrameworks": [
      "react",
      "vue3",
      "angular",
      "svelte",
      "preact",
      "html",
      "web-components",
      "solid"
    ],
    "icon": ""
  }
}
