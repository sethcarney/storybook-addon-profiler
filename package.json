{
  "name": "storybook-performance-profiler",
  "description": "A performance profiler panel addon for Storybook — real-time FPS, INP, CLS, memory, React Profiler metrics and more",
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "keywords": [
    "storybook",
    "addon",
    "performance",
    "profiler",
    "web-vitals",
    "fps",
    "inp",
    "cls",
    "react"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manager": {
      "types": "./dist/manager.d.ts",
      "default": "./dist/manager.js"
    },
    "./package.json": "./package.json",
    "./preset": {
      "types": "./dist/preset.d.ts",
      "default": "./dist/preset.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "**/*.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev": "concurrently \"tsup --watch\" \"storybook dev -p 6006\"",
    "lint": "eslint src/ --cache",
    "test": "vitest run",
    "test:watch": "vitest",
    "tsc": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "bundler": {
    "managerEntries": [
      "src/manager.tsx"
    ],
    "previewEntries": [
      "src/preview.ts",
      "src/index.ts"
    ],
    "nodeEntries": [
      "src/preset.ts"
    ]
  },
  "devDependencies": {
    "@storybook/icons": "^1.4.0",
    "@storybook/react": "^8.6.0",
    "@storybook/react-vite": "^8.6.0",
    "@types/node": "^25.3.0",
    "@types/react": "^18.2.0",
    "concurrently": "^9.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "^8.6.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "@storybook/icons": "*",
    "@storybook/react": "*",
    "react": "*",
    "storybook": "*"
  },
  "storybook": {
    "displayName": "Performance Profiler",
    "supportedFrameworks": [
      "react"
    ],
    "icon": ""
  }
}
