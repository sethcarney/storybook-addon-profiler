{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "angular-test": {
      "projectType": "application",
      "root": "",
      "sourceRoot": ".",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist-unused",
            "index": "index.html",
            "main": "main.ts",
            "tsConfig": "tsconfig.json"
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "browserTarget": "angular-test:build",
            "configDir": ".storybook",
            "tsConfig": "tsconfig.json",
            "compodoc": false,
            "port": 6008
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "browserTarget": "angular-test:build",
            "configDir": ".storybook",
            "tsConfig": "tsconfig.json",
            "compodoc": false,
            "outputDir": "../../storybook-static/angular"
          }
        }
      }
    }
  }
}
